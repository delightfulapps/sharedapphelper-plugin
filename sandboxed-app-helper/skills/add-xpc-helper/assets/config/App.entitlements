<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Downloading the helper archive. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Saving the downloaded archive wherever the user chooses. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Looking up a *global* Mach name from inside the sandbox needs this temporary exception.
	     App Review permits it with justification: the app connects only to the same-team, notarized
	     helper the user installs, enforced by the peer code-signing requirement on both ends. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>{{SERVICE_NAME}}</string>
	</array>
</dict>
</plist>
